# Base URL of the Room5 API server.
# Android emulator reaches the host machine via 10.0.2.2.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Optional web fallback included in shared invites. Native links use room5:///room/CODE.
# EXPO_PUBLIC_WEB_URL=https://your-room5-web-app.example

# Production uses .env.production.local through android:release, independently
# of this development file. See .env.production.example and RELEASE.md.
