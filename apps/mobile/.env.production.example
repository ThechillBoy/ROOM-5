# Copy to .env.production.local only after provisioning the production backend.
# Empty values are deliberate: local URLs and placeholder hosts fail validation.
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_API_URL=

# Optional public web origin for invite fallback.
EXPO_PUBLIC_WEB_URL=

# Increase for each subsequent Play Store upload.
ROOM5_ANDROID_VERSION_CODE=1

# Do not put server secrets or upload-key passwords in EXPO_PUBLIC_* variables.
# REST and Socket.io share EXPO_PUBLIC_API_URL; secure WebSockets use WSS.
