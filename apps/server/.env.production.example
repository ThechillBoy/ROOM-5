# Supply real values through the production host's environment/secret settings.
# This template is not loaded automatically and contains no usable credentials.
NODE_ENV=production
PORT=3000
# Real production HTTPS web origin.
CLIENT_URL=
# Production PostgreSQL connection string supplied by the provider.
DATABASE_URL=
# Stable random secret with at least 32 bytes of entropy; never use a template value.
SESSION_SECRET=

# Required in production. Use TLS where supported by the Redis provider.
# Configure Redis persistence/backups to preserve sessions across Redis restarts.
REDIS_URL=
