# Supply real values through the production host's environment/secret settings.
# This template is not loaded automatically and contains no usable credentials.
NODE_ENV=production
# Use the host-provided PORT when available; 3000 is the server's fallback.
PORT=3000
# Exact production HTTPS web origin, without a path or trailing slash.
# Both REST and Socket.io CORS use this value; do not use a wildcard.
CLIENT_URL=
# Private PostgreSQL connection string supplied by the provider.
# Use the provider's required TLS settings and keep this value server-only.
DATABASE_URL=
# Stable random secret with at least 32 bytes of entropy; never use a template value.
# Keep the same secret across restarts to preserve existing signed sessions.
SESSION_SECRET=

# Private Redis connection string; required when NODE_ENV=production.
# Use rediss:// when required by the provider. No MemoryStore fallback in production.
# Configure Redis persistence/backups to preserve sessions across Redis restarts.
REDIS_URL=
