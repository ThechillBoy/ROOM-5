{
  "name": "room-5",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-07",
  "vars": {
    "BACKEND_ORIGIN": "https://room-5-j9tp.onrender.com"
  },
  "assets": {
    "directory": "./apps/client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/socket.io", "/socket.io/*", "/health"]
  }
}
